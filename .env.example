# Copy this file to .env for local development.
# Never store real credentials in this file or commit them to Git.

# Application
APP_NAME=pro-text2sql
APP_ENV=local
APP_LOG_LEVEL=INFO
APP_DEBUG=false

# API and web
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Analytics database
# The runtime account must have SELECT permission only on approved schemas/views.
ANALYTICS_DATABASE_URL=postgresql://readonly_user:change-me@localhost:5432/analytics
ANALYTICS_DATABASE_DIALECT=postgresql
ANALYTICS_DATABASE_ALLOWED_SCHEMAS=analytics
ANALYTICS_DATABASE_ALLOWED_TABLES=
ANALYTICS_DATABASE_ALLOWED_FUNCTIONS=
ANALYTICS_DATABASE_POOL_SIZE=5
ANALYTICS_DATABASE_STATEMENT_TIMEOUT_MS=15000
ANALYTICS_DATABASE_MAX_ROWS=1000
ANALYTICS_DATABASE_ENABLE_EXPLAIN=true

# LLM provider
# Provider and model are intentionally unset until the related ADR is approved.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0

# Workflow limits
REQUEST_TIMEOUT_MS=60000
REQUEST_MAX_INPUT_CHARACTERS=10000
WORKFLOW_MAX_REPAIR_ATTEMPTS=2
WORKFLOW_TOKEN_BUDGET=
WORKFLOW_COST_BUDGET_USD=

# Semantic layer and versioned policies
SEMANTIC_CATALOG_PATH=packages/semantic_layer/catalog
SEMANTIC_CATALOG_VERSION=dev
SQL_POLICY_VERSION=dev
PROMPT_VERSION=dev

# Conversation state and audit storage
# Leave empty until the storage implementation is selected.
STATE_DATABASE_URL=
AUDIT_DATABASE_URL=
AUDIT_ENABLED=true
AUDIT_STORE_RAW_PROMPTS=false
AUDIT_STORE_RAW_SQL=false
AUDIT_STORE_RESULT_ROWS=false

# Authentication
# Disabled is suitable for local development only. Production must use an
# approved identity provider and authorization model.
AUTH_MODE=disabled
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=

# OpenTelemetry
OTEL_SERVICE_NAME=pro-text2sql-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_EXPORTER=console
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# Evaluation
EVALUATION_DATASET_PATH=evals/datasets
EVALUATION_REPORT_PATH=evals/reports/generated
