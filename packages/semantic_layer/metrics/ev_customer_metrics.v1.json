      "allowed_filter_fields": ["vehicle_model_code", "station_name", "station_scope", "station_region_code", "province_name"],
      "unit": "kWh", "freshness_requirement": "PT1H", "classification": "internal", "effective_from": "2026-09-15"
    },
    {
      "id": "average_successful_charging_duration_minutes", "version": "1.0.0", "status": "draft",
