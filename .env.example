# Copy this file to .env for local development.
# Never store real credentials in this file or commit them to Git.

# Application
APP_NAME=pro-text2sql
APP_ENV=local
APP_LOG_LEVEL=INFO
APP_DEBUG=false

# API and web
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
DEV_API_RELOAD=false
PUBLIC_API_BASE_URL=http://localhost:8000
ANALYTICS_API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Local PostgreSQL. compose.yaml creates the owner and a separate read-only
# runtime role. These example passwords are for local development only.
POSTGRES_DB=pro_text2sql
POSTGRES_USER=pro_text2sql_owner
POSTGRES_PASSWORD=local_owner_change_me
POSTGRES_PORT=5432
ANALYTICS_DATABASE_READONLY_USER=analytics_readonly
ANALYTICS_DATABASE_READONLY_PASSWORD=local_readonly_change_me

# This URL is used when the application runs directly on the host. Compose
# overrides localhost with the internal service hostname `db`. Keep the local
# read-only password URL-safe because Compose injects it into a connection URL.
ANALYTICS_DATABASE_PROVIDER=postgresql
ANALYTICS_DATABASE_URL=postgresql://analytics_readonly:local_readonly_change_me@localhost:5432/pro_text2sql
ANALYTICS_DATABASE_DIALECT=postgresql
ANALYTICS_DATABASE_POOL_MODE=direct
ANALYTICS_DATABASE_SSL_MODE=disable
ANALYTICS_DATABASE_ALLOWED_SCHEMAS=analytics
ANALYTICS_DATABASE_ALLOWED_TABLES=
ANALYTICS_DATABASE_ALLOWED_FUNCTIONS=
ANALYTICS_DATABASE_POOL_SIZE=5
ANALYTICS_DATABASE_STATEMENT_TIMEOUT_MS=15000
ANALYTICS_DATABASE_MAX_ROWS=1000
ANALYTICS_DATABASE_ENABLE_EXPLAIN=true
# Explicit kill switch. The query request must also set execute=true. The
# executor always starts a PostgreSQL READ ONLY transaction.
ANALYTICS_EXECUTION_ENABLED=false

# Optional remote Supabase configuration for a later staging environment.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=


# OpenAI-compatible LLM used as the Wren SQL agent. Wren validates the output.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-terra
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
LLM_REASONING_EFFORT=medium
LLM_TEMPERATURE=0

# Wren-first workflow limits
REQUEST_TIMEOUT_MS=60000
REQUEST_MAX_INPUT_CHARACTERS=10000
WORKFLOW_MAX_REPAIR_ATTEMPTS=2
WREN_PROJECT_PATH=wren/ev_analytics
WREN_MAX_SQL_ROWS=1000
# Wren-compatible memory: knowledge/sql/*.md is always the source of truth.
# auto selects LanceDB when the optional memory extra is installed, otherwise grep.
WREN_MEMORY_BACKEND=auto
WREN_MEMORY_PATH=
WREN_MEMORY_SCHEMA_THRESHOLD=30000
LLM_MAX_OUTPUT_TOKENS=1500

# Conversation state and audit storage
# Leave empty until the storage implementation is selected.
STATE_DATABASE_URL=
AUDIT_DATABASE_URL=
AUDIT_ENABLED=true
AUDIT_STORE_RAW_PROMPTS=false
AUDIT_STORE_RAW_SQL=false
AUDIT_STORE_RESULT_ROWS=false

# Authentication
# Disabled is suitable for local development only. Production must use an
# approved identity provider and authorization model.
AUTH_MODE=disabled
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=

# OpenTelemetry
OTEL_SERVICE_NAME=pro-text2sql-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_EXPORTER=console
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# Evaluation
EVALUATION_DATASET_PATH=evals/datasets
EVALUATION_REPORT_PATH=evals/reports/generated
