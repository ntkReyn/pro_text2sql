{
  "catalog_version": "1.0.0",
  "metrics": [
    {
      "id": "completed_po_line_count",
      "version": "1.0.0",
      "status": "draft",
      "label": "Số PO line đã giao đủ",
      "description": "Số purchase order line không bị hủy và đã nhận đủ số lượng đặt trong khoảng thời gian hoàn tất.",
      "business_owner": "unassigned",
      "technical_owner": "data-team",
      "base_relation": "analytics.supplier_delivery_performance_v1",
      "base_grain": ["po_line_id"],
      "expression": "COUNT(*)",
      "base_filters": ["is_completed = TRUE"],
      "time_dimension": "completed_at",
      "allowed_dimensions": ["supplier_name", "warehouse_name", "region_name", "delivery_week", "delivery_month"],
      "allowed_filter_fields": ["supplier_name", "warehouse_name", "region_name"],
      "unit": "po_line",
      "freshness_requirement": "P1D",
      "classification": "internal",
      "effective_from": "2026-09-14"
    },
    {
      "id": "late_completed_po_line_count",
      "version": "1.0.0",
      "status": "draft",
      "label": "Số PO line giao trễ",
      "description": "Số purchase order line đã giao đủ nhưng thời điểm hoàn tất sau ngày giao cam kết.",
      "business_owner": "unassigned",
      "technical_owner": "data-team",
      "base_relation": "analytics.supplier_delivery_performance_v1",
      "base_grain": ["po_line_id"],
      "expression": "COUNT(*) FILTER (WHERE is_late = TRUE)",
      "base_filters": ["is_completed = TRUE"],
      "time_dimension": "completed_at",
      "allowed_dimensions": ["supplier_name", "warehouse_name", "region_name", "delivery_week", "delivery_month"],
      "allowed_filter_fields": ["supplier_name", "warehouse_name", "region_name"],
      "unit": "po_line",
      "freshness_requirement": "P1D",
      "classification": "internal",
      "effective_from": "2026-09-14"
    },
    {
      "id": "late_delivery_rate",
      "version": "1.0.0",
      "status": "draft",
      "label": "Tỷ lệ giao hàng trễ",
      "description": "Tỷ lệ phần trăm PO line đã giao đủ có thời điểm hoàn tất sau ngày giao cam kết.",
      "business_owner": "unassigned",
      "technical_owner": "data-team",
      "base_relation": "analytics.supplier_delivery_performance_v1",
      "base_grain": ["po_line_id"],
      "expression": "100.0 * COUNT(*) FILTER (WHERE is_late = TRUE) / NULLIF(COUNT(*), 0)",
      "base_filters": ["is_completed = TRUE"],
      "time_dimension": "completed_at",
      "allowed_dimensions": ["supplier_name", "warehouse_name", "region_name", "delivery_week", "delivery_month"],
      "allowed_filter_fields": ["supplier_name", "warehouse_name", "region_name"],
      "unit": "percent",
      "freshness_requirement": "P1D",
      "classification": "internal",
      "effective_from": "2026-09-14"
    },
    {
      "id": "on_time_delivery_rate",
      "version": "1.0.0",
      "status": "draft",
      "label": "Tỷ lệ giao hàng đúng hạn",
      "description": "Tỷ lệ phần trăm PO line đã giao đủ không muộn hơn ngày giao cam kết.",
      "business_owner": "unassigned",
      "technical_owner": "data-team",
      "base_relation": "analytics.supplier_delivery_performance_v1",
      "base_grain": ["po_line_id"],
      "expression": "100.0 * COUNT(*) FILTER (WHERE is_on_time = TRUE) / NULLIF(COUNT(*), 0)",
      "base_filters": ["is_completed = TRUE"],
      "time_dimension": "completed_at",
      "allowed_dimensions": ["supplier_name", "warehouse_name", "region_name", "delivery_week", "delivery_month"],
      "allowed_filter_fields": ["supplier_name", "warehouse_name", "region_name"],
      "unit": "percent",
      "freshness_requirement": "P1D",
      "classification": "internal",
      "effective_from": "2026-09-14"
    },
    {
      "id": "average_delay_days",
      "version": "1.0.0",
      "status": "draft",
      "label": "Số ngày trễ trung bình",
      "description": "Số ngày trễ trung bình của các PO line đã giao đủ và giao sau ngày cam kết; trả null khi không có giao trễ.",
      "business_owner": "unassigned",
      "technical_owner": "data-team",
      "base_relation": "analytics.supplier_delivery_performance_v1",
      "base_grain": ["po_line_id"],
      "expression": "AVG(delay_days) FILTER (WHERE is_late = TRUE)",
      "base_filters": ["is_completed = TRUE"],
      "time_dimension": "completed_at",
      "allowed_dimensions": ["supplier_name", "warehouse_name", "region_name", "delivery_week", "delivery_month"],
      "allowed_filter_fields": ["supplier_name", "warehouse_name", "region_name"],
      "unit": "day",
      "freshness_requirement": "P1D",
      "classification": "internal",
      "effective_from": "2026-09-14"
    }
  ]
}
