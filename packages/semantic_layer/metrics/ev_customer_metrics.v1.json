{
  "catalog_version": "1.1.0",
  "metrics": [
    {
      "id": "successful_charging_session_count", "version": "1.0.0", "status": "draft",
      "label": "Số phiên sạc thành công", "description": "Số phiên sạc hoàn tất và có sản lượng điện lớn hơn 0 theo thời điểm bắt đầu.",
      "business_owner": "unassigned", "technical_owner": "data-team",
      "base_relation": "analytics.charging_session_analytics_v1", "base_grain": ["charging_session_id"],
      "expression": "COUNT(*)", "base_filters": ["session_status = 'completed'", "energy_delivered_kwh > 0"], "time_dimension": "started_at",
      "allowed_dimensions": ["vehicle_model_code", "station_name", "station_scope", "station_region_code", "province_name", "charging_week", "charging_month"],
      "allowed_filter_fields": ["vehicle_model_code", "station_name", "station_scope", "station_region_code", "province_name"],
      "unit": "charging_session", "freshness_requirement": "PT1H", "classification": "internal", "effective_from": "2026-09-15"
    },
    {
      "id": "failed_charging_session_count", "version": "1.0.0", "status": "draft",
      "label": "Số phiên sạc thất bại", "description": "Số phiên sạc có trạng thái thất bại theo thời điểm bắt đầu.",
      "business_owner": "unassigned", "technical_owner": "data-team",
      "base_relation": "analytics.charging_session_analytics_v1", "base_grain": ["charging_session_id"],
      "expression": "COUNT(*)", "base_filters": ["session_status = 'failed'"], "time_dimension": "started_at",
      "allowed_dimensions": ["vehicle_model_code", "station_name", "station_scope", "station_region_code", "province_name", "charging_week", "charging_month"],
      "allowed_filter_fields": ["vehicle_model_code", "station_name", "station_scope", "station_region_code", "province_name"],
      "unit": "charging_session", "freshness_requirement": "PT1H", "classification": "internal", "effective_from": "2026-09-15"
    },
    {
      "id": "charging_success_rate", "version": "1.0.0", "status": "draft",
      "label": "Tỷ lệ phiên sạc thành công", "description": "Phần trăm phiên hoàn tất có điện năng trên tổng phiên hoàn tất hoặc thất bại; loại trừ hủy và đang diễn ra.",
      "business_owner": "unassigned", "technical_owner": "data-team",
      "base_relation": "analytics.charging_session_analytics_v1", "base_grain": ["charging_session_id"],
      "expression": "100.0 * COUNT(*) FILTER (WHERE session_status = 'completed' AND energy_delivered_kwh > 0) / NULLIF(COUNT(*), 0)",
      "base_filters": ["session_status IN ('completed', 'failed')"], "time_dimension": "started_at",
      "allowed_dimensions": ["vehicle_model_code", "station_name", "station_scope", "station_region_code", "province_name", "charging_week", "charging_month"],
      "allowed_filter_fields": ["vehicle_model_code", "station_name", "station_scope", "station_region_code", "province_name"],
      "unit": "percent", "freshness_requirement": "PT1H", "classification": "internal", "effective_from": "2026-09-15"
    },
    {
      "id": "completed_energy_delivered_kwh", "version": "1.0.0", "status": "draft",
